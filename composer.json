{
    "name": "vielhuber/exchangehelper",
    "description": "Exchange/Outlook/Microsoft Graph helper for contacts, calendar events and To Do tasks with an MCP server.",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "vielhuber/simplemcp": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "vielhuber\\exchangehelper\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    },
    "bin": [
        "src/mcp-server.php"
    ]
}
